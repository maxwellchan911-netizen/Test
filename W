-- Helper function to find the absolute nearest target player
local function getNearestTarget()
    local nearestTarget = nil
    local shortestDistance = math.huge
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local myRoot = character.HumanoidRootPart

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local targetRoot = player.Character.HumanoidRootPart
            local distance = (myRoot.Position - targetRoot.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                nearestTarget = targetRoot
            end
        end
    end
    return nearestTarget
end

-- 1. Anti-Aim & Camera Spin Loop
RunService.RenderStepped:Connect(function(dt)
    local success, err = pcall(function()
        if not Toggles.AntiAimEnabled or not Toggles.AntiAimEnabled.Value then return end
        
        local character = LocalPlayer.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end
        local rootPart = character.HumanoidRootPart
        
        local speed = Options.AntiAimSpeed and Options.AntiAimSpeed.Value or 50
        local yawMode = Options.YawMode and Options.YawMode.Value or 'Spin (Screen Spin)'
        local spinCam = Toggles.SpinCamera and Toggles.SpinCamera.Value or false
        
        local currentTick = tick() * (speed * 0.5)
        local angleOffset = 0
        
        if yawMode == 'Spin (Screen Spin)' then
            angleOffset = (currentTick * 15) % 360
        elseif yawMode == 'Jitter' then
            angleOffset = (math.random(0, 1) == 1 and 90 or -90)
        elseif yawMode == 'Sideways' then
            angleOffset = 90
        elseif yawMode == 'Backwards' then
            angleOffset = 180
        elseif yawMode == 'Random Chaos' then
            angleOffset = math.random(0, 360)
        elseif yawMode == 'Static Desync' then
            angleOffset = 125
        end
        
        local camCF = Camera.CFrame
        local lookVector = camCF.LookVector
        local flatLook = Vector3.new(lookVector.X, 0, lookVector.Z).Unit
        
        if flatLook.Magnitude > 0 then
            local baseCF = CFrame.new(rootPart.Position, rootPart.Position + flatLook)
            rootPart.CFrame = baseCF * CFrame.Angles(0, math.rad(angleOffset), 0)
        end
        
        if spinCam and yawMode == 'Spin (Screen Spin)' then
            Camera.CFrame = Camera.CFrame * CFrame.Angles(0, 0, math.rad(dt * speed * 2))
        end
    end)
    if not success then
        -- Suppress repetitive log spam while maintaining safety
    end
end)

-- 2. UE Counter Loop
RunService.Heartbeat:Connect(function()
    pcall(function()
        if not Toggles.UECounterEnabled or not Toggles.UECounterEnabled.Value then return end
        
        local character = LocalPlayer.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end
        local rootPart = character.HumanoidRootPart
        
        local targetRoot = getNearestTarget()
        local rageSupport = Toggles.UECounterRageSupport and Toggles.UECounterRageSupport.Value or false
        
        local isThreatDetected = false
        local threatThreshold = rageSupport and 3000 or 1500
        
        if targetRoot then
            local distance = (rootPart.Position - targetRoot.Position).Magnitude
            if distance < threatThreshold then
                isThreatDetected = true
            end
        end
        
        if not isThreatDetected then
            rootPart.CFrame = CFrame.new(0, 999999999, 0)
        else
            local counterSpeed = Options.UECounterSpeed and Options.UECounterSpeed.Value or 50
            local mode = Options.UECounterMode and Options.UECounterMode.Value or 'Instant Retaliate'
            local timeVal = tick() * (counterSpeed * 0.5)
            
            local offsetX, offsetY, offsetZ = 0, 2, 0
            if mode == 'Instant Retaliate' then
                offsetX = math.cos(timeVal) * (rageSupport and 1.5 or 3)
                offsetZ = math.sin(timeVal) * (rageSupport and 1.5 or 3)
                offsetY = rageSupport and 0.5 or 2
            elseif mode == 'Quantum Flash' then
                offsetX = (math.random(-1, 1)) * (rageSupport and 2 or 5)
                offsetZ = (math.random(-1, 1)) * (rageSupport and 2 or 5)
                offsetY = math.random(0, rageSupport and 2 or 4)
            elseif mode == 'Absolute Annihilation' then
                offsetX = math.cos(timeVal * 2) * (rageSupport and 1 or 2)
                offsetZ = math.sin(timeVal * 2) * (rageSupport and 1 or 2)
                offsetY = rageSupport and 0 or 1
            elseif mode == 'Blink Strike' then
                offsetX = math.sin(timeVal) * (rageSupport and 2 or 4)
                offsetZ = math.cos(timeVal) * (rageSupport and 2 or 4)
                offsetY = rageSupport and 1 or 2
            end
            
            local strikePos = targetRoot.Position + Vector3.new(offsetX, offsetY, offsetZ)
            rootPart.CFrame = CFrame.new(strikePos, targetRoot.Position)
        end
    end)
end)

-- 3. Orbit Loop
RunService.Heartbeat:Connect(function()
    pcall(function()
        if not Toggles.OrbitEnabled or not Toggles.OrbitEnabled.Value then return end
        
        local character = LocalPlayer.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end
        local rootPart = character.HumanoidRootPart
        
        local targetRoot = getNearestTarget()
        if not targetRoot then return end
        
        local radius = Options.OrbitRadius and Options.OrbitRadius.Value or 10
        local speed = Options.OrbitSpeed and Options.OrbitSpeed.Value or 25
        local mode = Options.OrbitMode and Options.OrbitMode.Value or 'Circular'
        
        local timeVal = tick() * speed
        local offsetX, offsetY, offsetZ = 0, 0, 0
        
        if mode == 'Circular' then
            offsetX = math.cos(timeVal) * radius
            offsetZ = math.sin(timeVal) * radius
            offsetY = 0
        elseif mode == 'Zigzag' then
            offsetX = math.cos(timeVal) * radius
            offsetZ = math.sin(timeVal) * radius
            offsetY = math.sin(tick() * (speed * 2)) * (radius * 0.5)
        elseif mode == 'Spherical Chaos' then
            offsetX = math.cos(timeVal) * math.sin(timeVal * 0.5) * radius
            offsetY = math.sin(timeVal * 0.75) * radius
            offsetZ = math.sin(timeVal) * math.cos(timeVal * 0.5) * radius
        elseif mode == 'Vertical Wave' then
            offsetX = math.cos(timeVal) * radius
            offsetZ = math.sin(timeVal) * radius
            offsetY = math.cos(tick() * (speed * 1.5)) * radius
        elseif mode == 'Teleport Lock' then
            offsetX = (math.random(0, 1) == 0 and 1 or -1) * radius
            offsetZ = (math.random(0, 1) == 0 and 1 or -1) * radius
            offsetY = math.random(-2, 5)
        end
        
        local targetPos = targetRoot.Position + Vector3.new(offsetX, offsetY, offsetZ)
        rootPart.CFrame = CFrame.new(targetPos, targetRoot.Position)
    end)
end)

